# ── Required ──────────────────────────────────────────────
TARGET_URL=https://example.com          # Site to crawl / chaos-test

# ── LLM (host-native ollama by default) ─────────────────
# Default points at WSL-native / host-installed ollama on 127.0.0.1:11434.
# When the agent runs inside docker compose, the compose `environment` block
# rewrites this to `http://host.docker.internal:11434/v1`. The legacy
# in-compose ollama service lives under the opt-in `compose-llm` profile.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama                      # API key (use "ollama" for local Ollama)
LLM_MODEL=gemma4:e4b                    # Model used by Pi-driven coordinator/planner/judge/observer sessions and Stagehand
# ── Exploration ──────────────────────────────────────────
MAX_PAGES=50                            # Stop after visiting this many pages
MAX_FINDINGS=100                        # Max findings to record
HEADLESS=true                           # Run browser headless (set "false" to watch)

# ── Kea API ──────────────────────────────────────────────
KEA_API_URL=http://localhost:4000       # @kea/api base URL

# ── Session config (FDD-0010) ────────────────────────────
# Optional JSON-encoded SessionConfig used to seed features at startup. See
# shared/src/schemas.ts SessionConfigSchema. Example:
#   SESSION_CONFIG_JSON='{"rerunPolicy":"full","seedFeatures":[{"name":"home","urlPatterns":["http://localhost:8081/"]}]}'
# SESSION_CONFIG_JSON=

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=info                          # pino log level (trace/debug/info/warn/error/fatal)
NODE_ENV=production                     # "development" for pretty-printed logs
SEQ_URL=http://localhost:5341           # Seq ingestion URL (omit to disable)
# SEQ_API_KEY=                          # Seq API key (optional for local)
